# Imperial Codex Environment Variables

# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your actual values
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM APIS
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (Database + Auth)
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────────
# SESSION & SECURITY
# ─────────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-here-min-32-chars

# Generate: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=your-vault-encryption-key-min-32-chars

# ─────────────────────────────────────────────────────────────────────────────
# BACKGROUND JOBS / CRON
# ─────────────────────────────────────────────────────────────────────────────
# Secret token for cron endpoints (prevent unauthorized triggers)
# Generate: openssl rand -base64 32
CRON_SECRET=your-cron-secret-key-here

# ─────────────────────────────────────────────────────────────────────────────
# WEBHOOKS & INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# Slack bot token for alerts
# Get from: https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# Slack channel for alerts
SLACK_ALERT_CHANNEL=#imperial-codex-alerts

# Webhook URL for external alerts (e.g., Discord, custom)
WEBHOOK_ALERT_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Brave Search API for web search
# Get from: https://api.search.brave.com/
BRAVE_API_KEY=your-brave-api-key

# GitHub token for repo access
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub repository (format: owner/repo)
GITHUB_REPO=your-username/imperial-codex

# ─────────────────────────────────────────────────────────────────────────────
# MCP (Model Context Protocol)
# ─────────────────────────────────────────────────────────────────────────────
# URL where MCP server is exposed (for Claude Desktop, Cursor, etc.)
MCP_SERVER_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND / NEXT.JS
# ─────────────────────────────────────────────────────────────────────────────
# Application URL (used for redirects, links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: AWS (for infrastructure/deployment)
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Vector Search / Embeddings
# ─────────────────────────────────────────────────────────────────────────────
# Qdrant endpoint
QDRANT_URL=http://qdrant:6333

# Pinecone API key
PINECONE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────────────────────────
# 1. Never commit .env.local to git (it's in .gitignore)
# 2. For production, use GitHub Secrets or environment management tools
# 3. All API keys should be kept private and rotated regularly
# 4. For local development, start with just: OPENAI_API_KEY, ANTHROPIC_API_KEY, SUPABASE_*
# 5. SESSION_SECRET and VAULT_ENCRYPTION_KEY MUST be at least 32 characters
