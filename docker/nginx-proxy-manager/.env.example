# ===========================================
# Environment Configuration for dalizebo.co.za
# Modern Full Stack Deployment
# ===========================================
# Copy this file to .env and customize all values
# NEVER commit .env to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL
POSTGRES_USER=dalizebo_admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD_32CHARS_MIN
POSTGRES_DB=dalizebo

# MariaDB/MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_SECURE_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=dalizebo
MYSQL_USER=dalizebo_user
MYSQL_PASSWORD=CHANGE_ME_SECURE_MYSQL_USER_PASSWORD

# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_SECURE_MONGO_PASSWORD
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=CHANGE_ME_SECURE_MONGO_EXPRESS

# Redis
REDIS_PASSWORD=CHANGE_ME_SECURE_REDIS_PASSWORD_32CHARS
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=CHANGE_ME_SECURE_REDIS_UI_PASSWORD

# PgAdmin
PGADMIN_EMAIL=admin@dalizebo.co.za
PGADMIN_PASSWORD=CHANGE_ME_SECURE_PGADMIN_PASSWORD

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_GRAFANA_PASSWORD

# ===========================================
# SECURITY SERVICES
# ===========================================

# CrowdSec
CROWDSEC_AGENT_USER=crowdsec
CROWDSEC_AGENT_PASSWORD=CHANGE_ME_SECURE_CROWDSEC_PASSWORD

# Vaultwarden (Password Manager)
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_SECURE_VAULT_ADMIN_TOKEN_64CHARS

# ===========================================
# DEVOPS TOOLS
# ===========================================

# VS Code Server
CODE_SERVER_PASSWORD=CHANGE_ME_SECURE_CODE_SERVER_PASSWORD

# Gitea (uses PostgreSQL credentials above)

# Drone CI
DRONE_RPC_SECRET=CHANGE_ME_SECURE_DRONE_RPC_SECRET_64CHARS
DRONE_GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
DRONE_GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET

# ===========================================
# NETWORKING
# ===========================================

# Cloudflare Tunnel (Optional - leave empty if not using)
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_IF_USING

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# VPS IP Address
SERVER_IP=2.28.6.68

# Domain Configuration
PRIMARY_DOMAIN=dalizebo.co.za
WWW_DOMAIN=www.dalizebo.co.za

# Timezone
TZ=Africa/Johannesburg

# ===========================================
# IMPORTANT SECURITY NOTES
# ===========================================
# 1. Replace ALL CHANGE_ME_* values with strong, unique passwords
# 2. Use a password manager to generate and store passwords
# 3. Minimum password length: 32 characters for databases, 64 for tokens
# 4. Never commit the .env file to git or share it publicly
# 5. Rotate passwords regularly (every 90 days recommended)
# 6. Enable 2FA on all services that support it
# ===========================================
