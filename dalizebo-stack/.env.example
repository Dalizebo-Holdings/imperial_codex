# Dalizebo.co.za - 10 Pillars Full Stack Configuration
# SECURE THIS FILE: chmod 600 .env && chown root:root .env

# ==========================================
# GLOBAL SETTINGS
# ==========================================
TZ=Africa/Johannesburg
DOMAIN=dalizebo.co.za
EMAIL=admin@dalizebo.co.za

# Network Settings
INTERNAL_NETWORK=dalizebo-internal
PROXY_NETWORK=dalizebo-proxy

# Traefik Dashboard Authentication (htpasswd format)
# Generate with: htpasswd -nb admin your_password | sed 's/$$/$$$$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$CHANGE_ME_TRAEFIK_AUTH

# ==========================================
# PILLAR 1: EXECUTIVE COCKPIT & OBSERVABILITY
# ==========================================
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_SECURE_123!

# Prometheus
PROMETHEUS_RETENTION_DAYS=15

# ==========================================
# PILLAR 2: MANAGER'S OFFICE & OPERATIONAL SUITE
# ==========================================
# Nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_NC_SECURE_456!
NEXTCLOUD_TRUSTED_DOMAINS=office.dalizebo.co.za,dalizebo.co.za

# Outline (Docs)
OUTLINE_SECRET_KEY=CHANGE_ME_OUTLINE_SECRET_789!
OUTLINE_URL=https://docs.dalizebo.co.za
OIDC_CLIENT_ID=outline-client
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_SECRET_abc!

# Vaultwarden (Password Manager)
ADMIN_TOKEN=CHANGE_ME_VAULT_ADMIN_TOKEN_xyz!
SIGNUP_ALLOWED=false
INVITATIONS_ALLOWED=true

# Chatwoot (Customer Success)
CHATWOOT_INSTALLATION_IDENTIFIER=dalizebo-prod
SECRET_KEY_BASE=CHANGE_ME_CHATWOOT_SECRET_def!

# ==========================================
# PILLAR 3: FINTECH, BANKING, ACCOUNTING (ERPNext)
# ==========================================
# ERPNext
ERP_NEXT_SITE_NAME=erp.dalizebo.co.za
DB_PASSWORD=CHANGE_ME_ERP_DB_PASS_ghi!
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS_jkl!

# Payment Gateway Keys (Store securely, do not commit to git)
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
OZOW_MERCHANT_CODE=CHANGE_ME
OZOW_PRIVATE_KEY=CHANGE_ME
CAPITEC_PAY_API_KEY=CHANGE_ME

# ==========================================
# PILLAR 4: STOREFRONT & SUPPLIERS
# ==========================================
# Supabase (Backend for Storefront/Affiliates)
SUPABASE_ANON_KEY=CHANGE_ME_SUPABASE_ANON_mno!
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_pqr!
JWT_SECRET=CHANGE_ME_JWT_SECRET_stu!
POSTGRES_PASSWORD=CHANGE_ME_SUPA_DB_PASS_vwx!

# Supplier/Vendor Directories
SUPPLIER_DIR=/opt/suppliers
VENDOR_DIR=/opt/vendors

# ==========================================
# PILLAR 5: AI DIGITAL TWIN
# ==========================================
# Ollama (Local AI)
OLLAMA_HOST=0.0.0.0
OLLAMA_MODELS=Llama-3,Mistral,Qwen-Coder

# Agent Dev Workspace
AGENT_WORKSPACE=/home/agentdev/agents-workspace

# ==========================================
# PILLAR 6: OMNICHANNEL SUPPLY
# ==========================================
# Inventory Sync Settings
SYNC_INTERVAL_MINUTES=15
TAKEALOT_API_KEY=CHANGE_ME_TAKEALOT_KEY_yza!

# ==========================================
# PILLAR 7: MARKETING & TRAFFIC
# ==========================================
# Zoho Mail
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_USER=notifications@dalizebo.co.za
ZOHO_SMTP_PASS=CHANGE_ME_ZOHO_PASS_bcd!

# n8n Automation
N8N_BASIC_AUTH_USER=n8n-admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_N8N_PASS_efg!
WEBHOOK_URL=https://n8n.dalizebo.co.za

# ==========================================
# PILLAR 8: SECURITY & BACKUP
# ==========================================
# CrowdSec
BOUNCE_DURATION=4h
MAX_BOUNCES=5

# Backup Settings
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_KEY_hij!
BACKUP_RETENTION_DAYS=30
ZRAM_SIZE_GB=4

# ==========================================
# PILLAR 9: R&D & CI/CD
# ==========================================
# Gitea (Git Server)
GITEA_ROOT_PASSWORD=CHANGE_ME_GITEA_PASS_klm!
GITEA_RUN_MODE=prod

# Drone CI
DRONE_RPC_SECRET=CHANGE_ME_DRONE_SECRET_nop!

# Imperial Codex Path
CODEX_PATH=/opt/imperial-codex

# ==========================================
# PILLAR 10: CUSTOMER SUCCESS & LOYALTY
# ==========================================
# WhatsApp API (GreenAPI or similar)
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=CHANGE_ME_INSTANCE_qrs!
WHATSAPP_API_TOKEN=CHANGE_ME_WHATSAPP_TOKEN_tuv!

# Loyalty Program
LOYALTY_POINT_VALUE=0.01 # 1 point = R0.01
MIN_REDEMPTION_POINTS=100
