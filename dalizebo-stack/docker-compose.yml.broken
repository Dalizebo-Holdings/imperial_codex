version: "3.9"

x-logging: &default-logging
  driver: "local"
  options:
    max-size: "10m"
    max-file: "3"

x-restart-policy: &default-restart
  restart: unless-stopped

networks:
  proxy:
    external: false
    name: traefik-proxy
  internal:
    driver: bridge
    internal: true

volumes:
  traefik_data:
  grafana_data:
  prometheus_data:
  nextcloud_data:
  vaultwarden_data:
  chatwoot_data:
  erpnext_data:
  supabase_data:
  gitea_data:
  n8n_data:
  ollama_data:
  agent_workspace:
  backups:

services:
  # ==========================================
  # PILLAR 1: Executive Cockpit
  # ==========================================
  traefik:
    image: traefik:v3.0
    container_name: traefik
    <<: *default-restart
    command:
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.letsencrypt.acme.tlschallenge=true"
      - "--certificatesresolvers.letsencrypt.acme.email=admin@dalizebo.co.za"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
      - "--accesslog=true"
      - "--accesslog.filepath=/logs/traefik.log"
      - "--log.level=INFO"
    ports:
      - "80:80"
      - "443:443"
      - "9090:8080"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - traefik_data:/letsencrypt
      - ./logs/traefik:/logs
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.dashboard.rule=Host(`cockpit.dalizebo.co.za`)"
      - "traefik.http.routers.dashboard.entrypoints=websecure"
      - "traefik.http.routers.dashboard.tls.certresolver=letsencrypt"
      - "traefik.http.routers.dashboard.service=api@internal"
      - "traefik.http.routers.dashboard.middlewares=auth"
      - "traefik.http.middlewares.auth.basicauth.users=${TRAEFIK_DASHBOARD_USER:-admin}:${TRAEFIK_DASHBOARD_PASSWORD}"
    logging: *default-logging
    networks:
      - proxy

  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    <<: *default-restart
    volumes:
      - ./configs/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml
      - prometheus_data:/prometheus
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time=15d"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.prometheus.rule=Host(`cockpit.dalizebo.co.za`) && PathPrefix(`/metrics`)"
      - "traefik.http.routers.prometheus.entrypoints=websecure"
      - "traefik.http.routers.prometheus.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    <<: *default-restart
    environment:
      - GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER:-admin}
      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
      - GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-piechart-panel
    volumes:
      - grafana_data:/var/lib/grafana
      - ./configs/grafana/provisioning:/etc/grafana/provisioning
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.grafana.rule=Host(`cockpit.dalizebo.co.za`)"
      - "traefik.http.routers.grafana.entrypoints=websecure"
      - "traefik.http.routers.grafana.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal
    depends_on:
      - prometheus

  uptime-kuma:
    image: louislam/uptime-kuma:1
    container_name: uptime-kuma
    <<: *default-restart
    volumes:
      - ./data/uptime-kuma:/app/data
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.kuma.rule=Host(`status.dalizebo.co.za`)"
      - "traefik.http.routers.kuma.entrypoints=websecure"
      - "traefik.http.routers.kuma.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy

  # ==========================================
  # PILLAR 2: Manager's Office
  # ==========================================
  nextcloud:
    image: nextcloud:stable
    container_name: nextcloud
    <<: *default-restart
    environment:
      - NEXTCLOUD_ADMIN_USER=${NEXTCLOUD_ADMIN_USER:-admin}
      - NEXTCLOUD_ADMIN_PASSWORD=${NEXTCLOUD_ADMIN_PASSWORD}
      - NEXTCLOUD_TRUSTED_DOMAINS=${NEXTCLOUD_TRUSTED_DOMAINS}
    volumes:
      - nextcloud_data:/var/www/html
      - ./data/nextcloud/apps:/var/www/html/custom_apps
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.nextcloud.rule=Host(`office.dalizebo.co.za`)"
      - "traefik.http.routers.nextcloud.entrypoints=websecure"
      - "traefik.http.routers.nextcloud.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal
    depends_on:
      - postgres

  vaultwarden:
    image: dani-garcia/vaultwarden:latest
    container_name: vaultwarden
    <<: *default-restart
    environment:
      - ADMIN_TOKEN=${VAULTWARDEN_ADMIN_TOKEN}
      - DOMAIN=${VAULTWARDEN_DOMAIN}
      - WEBSOCKET_ENABLED=true
    volumes:
      - vaultwarden_data:/data
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.vaultwarden.rule=Host(`vault.dalizebo.co.za`)"
      - "traefik.http.routers.vaultwarden.entrypoints=websecure"
      - "traefik.http.routers.vaultwarden.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy

  chatwoot:
    image: chatwoot/chatwoot:latest
    container_name: chatwoot
    <<: *default-restart
    environment:
      - FRONTEND_URL=${CHATWOOT_FRONTEND_URL}
      - BACKEND_URL=${CHATWOOT_BACKEND_URL}
      - SECRET_KEY_BASE=${CHATWOOT_SECRET_KEY}
      - POSTGRES_HOST=postgres
      - POSTGRES_PORT=5432
      - POSTGRES_DATABASE=dalizebo_main
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
    volumes:
      - chatwoot_data:/app/storage
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.chatwoot.rule=Host(`chat.dalizebo.co.za`)"
      - "traefik.http.routers.chatwoot.entrypoints=websecure"
      - "traefik.http.routers.chatwoot.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal
    depends_on:
      - postgres
      - redis

  # ==========================================
  # PILLAR 3: Fintech & ERP
  # ==========================================
  erpnext:
    image: frappe/erpnext:latest
    container_name: erpnext
    <<: *default-restart
    environment:
      - DB_PASSWORD=${ERP_NEXT_DB_PASSWORD}
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - SITE_NAME=${ERP_NEXT_SITE_NAME}
      - ADMIN_PASSWORD=${ERP_NEXT_ADMIN_PASSWORD}
    volumes:
      - erpnext_data:/home/frappe/frappe-bench/sites
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.erpnext.rule=Host(`erp.dalizebo.co.za`)"
      - "traefik.http.routers.erpnext.entrypoints=websecure"
      - "traefik.http.routers.erpnext.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal
    depends_on:
      - mariadb
      - redis

  # ==========================================
  # PILLAR 4 & 5: Storefront & AI
  # ==========================================
  supabase-db:
    image: supabase/postgres:15.1.0.117
    container_name: supabase-db
    <<: *default-restart
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${SUPABASE_DB_PASSWORD}
      - POSTGRES_DB=dalizebo_main
      - JWT_SECRET=${SUPABASE_GOTRUE_JWT_SECRET}
    volumes:
      - supabase_data:/var/lib/postgresql/data
    logging: *default-logging
    networks:
      - internal

  ollama:
    image: ollama/ollama:latest
    container_name: ollama
    <<: *default-restart
    volumes:
      - ollama_data:/root/.ollama
      - ./models:/ollama/models
    deploy:
      resources:
        limits:
          memory: 8G
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.ollama.rule=Host(`ai.dalizebo.co.za`)"
      - "traefik.http.routers.ollama.entrypoints=websecure"
      - "traefik.http.routers.ollama.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal

  # ==========================================
  # PILLAR 7: Marketing & Automation
  # ==========================================
  n8n:
    image: n8nio/n8n:latest
    container_name: n8n
    <<: *default-restart
    environment:
      - N8N_ENCRYPTION_KEY=${N8N_ENCRYPTION_KEY}
      - N8N_HOST=${N8N_HOST}
      - N8N_PORT=${N8N_PORT}
      - N8N_PROTOCOL=${N8N_PROTOCOL}
      - N8N_BASIC_AUTH_ACTIVE=${N8N_BASIC_AUTH_ACTIVE}
      - N8N_BASIC_AUTH_USER=${N8N_BASIC_AUTH_USER}
      - N8N_BASIC_AUTH_PASSWORD=${N8N_BASIC_AUTH_PASSWORD}
      - WEBHOOK_URL=${N8N_WEBHOOK_URL}
      - DB_TYPE=postgresdb
      - DB_POSTGRESDB_HOST=postgres
      - DB_POSTGRESDB_PORT=5432
      - DB_POSTGRESDB_DATABASE=dalizebo_main
      - DB_POSTGRESDB_USER=${POSTGRES_USER}
      - DB_POSTGRESDB_PASSWORD=${POSTGRES_PASSWORD}
    volumes:
      - n8n_data:/home/node/.n8n
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.n8n.rule=Host(`n8n.dalizebo.co.za`)"
      - "traefik.http.routers.n8n.entrypoints=websecure"
      - "traefik.http.routers.n8n.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal
    depends_on:
      - postgres

  # ==========================================
  # PILLAR 8: Security & Backup
  # ==========================================
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: crowdsec
    <<: *default-restart
    environment:
      - GID="${GID-1000}"
      - COLLECTIONS=crowdsecurity/traefik crowdsecurity/linux
    volumes:
      - ./data/crowdsec/db:/var/lib/crowdsec/data
      - ./configs/crowdsec:/etc/crowdsec
      - ./logs/traefik:/logs/traefik:ro
    logging: *default-logging
    networks:
      - proxy

  # ==========================================
  # PILLAR 9: R&D & CI/CD
  # ==========================================
  gitea:
    image: gitea/gitea:latest
    container_name: gitea
    <<: *default-restart
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__database__DB_TYPE=postgres
      - GITEA__database__HOST=postgres:5432
      - GITEA__database__NAME=gitea
      - GITEA__database__USER=${POSTGRES_USER}
      - GITEA__database__PASSWD=${POSTGRES_PASSWORD}
      - GITEA__security__SECRET_KEY=${GITEA_SECRET}
    volumes:
      - gitea_data:/data
      - /home/agentdev/agents-workspace:/data/git/agents-workspace
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.gitea.rule=Host(`git.dalizebo.co.za`)"
      - "traefik.http.routers.gitea.entrypoints=websecure"
      - "traefik.http.routers.gitea.tls.certresolver=letsencrypt"
    logging: *default-logging
    networks:
      - proxy
      - internal
    depends_on:
      - postgres

  # ==========================================
  # Shared Databases
  # ==========================================
  postgres:
    image: postgres:15-alpine
    container_name: postgres
    <<: *default-restart
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=${POSTGRES_DB}
    volumes:
      - ./data/postgres:/var/lib/postgresql/data
    logging: *default-logging
    networks:
      - internal

  mariadb:
    image: mariadb:10.6
    container_name: mariadb
    <<: *default-restart
    environment:
      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=${MYSQL_DATABASE}
      - MYSQL_USER=${MYSQL_USER}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
    volumes:
      - ./data/mariadb:/var/lib/mysql
    logging: *default-logging
    networks:
      - internal

  redis:
    image: redis:7-alpine
    container_name: redis
    <<: *default-restart
    command: redis-server --requirepass ${REDIS_PASSWORD}
    volumes:
      - ./data/redis:/data
    logging: *default-logging
    networks:
      - internal

  # ==========================================
  # Storage Cleanup Service (Pillar 8)
  # ==========================================
  storage-monitor:
    image: alpine:latest
    container_name: storage-monitor
    <<: *default-restart
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./scripts:/scripts
    command: >
      sh -c "while true; do
        if [ \$(df / | tail -1 | awk '{print \$5}' | sed 's/%//') -gt 85 ]; then
          docker system prune -af --volumes;
        fi;
        sleep 3600;
      done"
    logging: *default-logging
    networks:
      - internal
