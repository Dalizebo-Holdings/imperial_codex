{
  "mcpServers": {
    "imperial-codex": {
      "command": "node",
      "args": ["/app/mcp-server.js"],
      "env": {
        "NODE_ENV": "production",
        "PORT": "3001"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "imperial-codex-http": {
      "type": "http",
      "url": "http://localhost:3001",
      "disabled": false,
      "alwaysAllow": []
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "disabled": false,
      "alwaysAllow": []
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git"],
      "env": {
        "GIT_REPO_PATH": "/app"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "DATABASE_URL": "postgresql://user:password@localhost:5432/imperial_codex"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "web-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-web-search"],
      "env": {
        "SEARCH_ENGINE": "brave",
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "disabled": false,
      "alwaysAllow": []
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite"],
      "env": {
        "DATABASE_PATH": "/app/data/imperial-codex.db"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_CHANNEL": "#imperial-codex-alerts"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_REPO": "${GITHUB_REPO}"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"],
      "env": {
        "DOCKER_SOCKET": "unix:///var/run/docker.sock"
      },
      "disabled": false,
      "alwaysAllow": []
    },
    "http": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-http"],
      "disabled": false,
      "alwaysAllow": []
    }
  }
}
